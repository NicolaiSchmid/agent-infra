+import { Agent } from "undici";
+
+// Only internal callbacks use this dispatcher. Their owning action's existing
+// AbortSignal bounds their lifetime; a separate 300s headers deadline must not
+// cut off a nested action. Body and connection deadlines retain Undici defaults.
+export function createCallbackDispatcher(options: Agent.Options = {}): Agent {
+  return new Agent({ ...options, headersTimeout: 0 });
+}
+
+export const callbackDispatcher = createCallbackDispatcher();
