# Host-specific, non-secret settings for traefik/compose.yaml on black.
TRAEFIK_DATA_DIR=/var/lib/client-data/traefik
TAILNET_HOST=black.takaya-buri.ts.net
ACME_EMAIL=nicolai@schmid.uno
