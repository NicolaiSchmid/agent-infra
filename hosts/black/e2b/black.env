# Host-specific, non-secret settings for E2B Embed on black, read after the
# upstream .env (pinned in hosts/black/e2b.nix) and before the secrets file
# that e2b-secrets.service creates on first start.

# 2 MiB hugepages reserved for sandbox guest memory, set by NixOS (e2b.nix
# reads this line) and checked by host-setup. 768 = 1.5 GiB: two 512 MiB
# sandboxes at full memory, or one paused and resumed (the restore maps a
# memfd besides the 120 pages the orchestrator keeps reserved; 512 was too
# small for that). Upstream's default is 2048; black's headroom next to the
# atlas VM is about 8 GB, and black's fragmented memory gave no more than
# ~800 pages at runtime (a boot reserves them easily).
HUGEPAGES=768
NBDS_MAX=64
